# Copy to .env for local dev. In production set these as Railway variables.
# Get a fresh token from @BotFather (/newbot or /revoke). NEVER commit the real one.
BOT_TOKEN=123456:your-bot-token-here

# Public URL of the deployed Mini App (Railway service domain), no scheme needed.
WEBAPP_URL=your-app.up.railway.app

# Telegram numeric user id of the admin who approves new users.
ADMIN_ID=0

# Optional: path to the shared SQLite file. Point this at a mounted volume
# in production so data survives redeploys, e.g. /data/sklat.db
# DB_PATH=/data/sklat.db

# Optional: set to 1 ONLY for local browser testing to bypass Telegram auth.
# Must be unset/0 in production.
# DEV_OPEN_ACCESS=0
