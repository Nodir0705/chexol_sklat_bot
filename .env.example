# Copy to .env on the VPS and fill in. NEVER commit the real .env.

# Get a fresh token from @BotFather (/newbot or /revoke).
BOT_TOKEN=123456:your-bot-token-here

# Domain the Mini App is served from. Must be a real domain with an A record
# pointing at this VPS — Caddy issues the TLS certificate for it, and Telegram
# refuses a bare IP or a self-signed certificate for web_app buttons.
DOMAIN=sklat.example.com
WEBAPP_URL=sklat.example.com

# Telegram numeric user id of the admin who approves new users.
ADMIN_ID=0

# Telegram ids auto-approved at startup (comma-separated). ADMIN_ID is always
# included. Leave this set — if it is UNSET, config.py falls back to a hardcoded
# id (752030660) which then gets warehouse access on every startup.
APPROVED_IDS=0

# Path to the shared SQLite file. docker-compose sets this to /data/sklat.db
# (host ./data/), so leave it alone unless running outside Docker.
# DB_PATH=/data/sklat.db

# Set to 1 ONLY for local browser testing to bypass Telegram auth.
# Must be unset/0 in production.
# DEV_OPEN_ACCESS=0
